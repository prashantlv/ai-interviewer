# Dockerfile for RQ Worker (Bot Manager)
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install all dependencies (worker needs both web_server and server deps)
COPY web_server/requirements.txt /app/web_server/requirements.txt
COPY server/requirements.txt /app/server/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r web_server/requirements.txt && \
    pip install --no-cache-dir -r server/requirements.txt

# Copy application code
COPY web_server/ /app/web_server/
COPY server/ /app/server/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Run RQ worker
WORKDIR /app/web_server
CMD ["rq", "worker", "ai_bots", "--with-scheduler"]

