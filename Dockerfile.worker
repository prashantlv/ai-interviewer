# Dockerfile for RQ Worker (Bot Manager)
#
# Note: pipecat-ai pulls in PyAV (av). On Python 3.12, this often builds from source,
# which requires pkg-config + FFmpeg dev headers. We use a multi-stage build to keep
# the runtime image smaller while still supporting compilation.

FROM python:3.12-slim AS builder

WORKDIR /app

# Build dependencies (kept only in builder stage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    pkg-config \
    curl \
    # FFmpeg dev headers for PyAV
    libavcodec-dev \
    libavdevice-dev \
    libavfilter-dev \
    libavformat-dev \
    libavutil-dev \
    libswresample-dev \
    libswscale-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install all dependencies (worker needs both web_server and server deps)
COPY web_server/requirements.txt /app/web_server/requirements.txt
COPY server/requirements.txt /app/server/requirements.txt

# Install to a dedicated prefix so we can copy into runtime stage
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefer-binary -r /app/web_server/requirements.txt --prefix /install && \
    pip install --no-cache-dir --prefer-binary -r /app/server/requirements.txt --prefix /install


FROM python:3.12-slim

WORKDIR /app

# Runtime deps only (FFmpeg libs needed by PyAV at runtime)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Bring in Python deps from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY web_server/ /app/web_server/
COPY server/ /app/server/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Run RQ worker
WORKDIR /app/web_server
CMD ["rq", "worker", "ai_bots", "--with-scheduler"]

